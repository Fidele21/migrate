    <h3 style="margin:0; font-family:var(--f-head);" id="overlay-title">Loading…</h3>
    <button id="overlay-close" style="background:none; border:none; font-size:32px; cursor:pointer; color:var(--tertiary);">&times;</button>
  </div>
  <iframe id="overlay-iframe" style="width:100%; height:calc(100% - 60px); border:0; background:var(--canvas);"></iframe>
