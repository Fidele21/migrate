@push('scripts')
<script>
/* Section 3 and 4 are mutually exclusive, decided by the system found on
   site — a septic tank and a treatment plant are different pieces of
   infrastructure, not two stages of the same one. */
(function () {
  var select = document.getElementById('ww_system_type');
  var sections = document.querySelectorAll('.wwp-conditional');
  if (!select) return;

  function apply() {
    var value = select.value;
    sections.forEach(function (sec) {
      var show = sec.dataset.showsFor === value;
      sec.style.display = show ? '' : 'none';
      /* Disabled as well as hidden — a hidden input still posts, and
         switching system type after filling one section in would
         otherwise submit values for infrastructure that was never
         actually found on site. */
      sec.querySelectorAll('input, select, textarea').forEach(function (el) {
        el.disabled = !show;
      });
    });
  }

  select.addEventListener('change', apply);
  apply();
})();

/* "Other" free-text fields appear only when Other is actually chosen. */
(function () {
  document.querySelectorAll('select[data-toggle-other]').forEach(function (select) {
    select.addEventListener('change', function () {
      var target = document.getElementById(select.dataset.toggleOther);
      if (target) target.style.display = (select.value === 'other') ? '' : 'none';
    });
  });

  document.querySelectorAll('[data-toggle-other-check]').forEach(function (input) {
    input.addEventListener('change', function () {
      var target = document.getElementById(input.dataset.toggleOtherCheck);
      if (target) target.style.display = input.checked ? '' : 'none';
    });
  });
})();

/* Own copy of the district/sector/cell cascade — this page does not
   share inspection/form.blade.php, so it does not share that page's
   script or its data either. Sourced from the same config either way. */
(function () {
  var KIGALI = @json(config('kigali'));

  var dEl = document.getElementById('wwp-district');
  var sEl = document.getElementById('wwp-sector');
  var cEl = document.getElementById('wwp-cell');
  if (!dEl || !sEl || !cEl) return;

  var savedSector = @json(old('sector', $entity->sector ?? ''));
  var savedCell   = @json(old('cell', $entity->cell ?? ''));

  function fill(select, options, keep, placeholder) {
    select.innerHTML = '<option value="">' + placeholder + '</option>';
    options.forEach(function (v) {
      var o = document.createElement('option');
      o.value = v; o.textContent = v;
      if (keep && v === keep) o.selected = true;
      select.appendChild(o);
    });
  }

  function onDistrict(keep) {
    var sectors = dEl.value && KIGALI[dEl.value] ? Object.keys(KIGALI[dEl.value]) : [];
    fill(sEl, sectors, keep ? savedSector : '', 'Choose');
    onSector(keep);
  }

  function onSector(keep) {
    var cells = (dEl.value && sEl.value && KIGALI[dEl.value] && KIGALI[dEl.value][sEl.value])
      ? KIGALI[dEl.value][sEl.value] : [];
    fill(cEl, cells, keep ? savedCell : '', 'Choose');
  }

  dEl.addEventListener('change', function () { onDistrict(false); });
  sEl.addEventListener('change', function () { onSector(false); });
  onDistrict(true);
})();

/* Own copy of GPS capture. */
(function () {
  var btn = document.getElementById('wwp-gps-capture');
  var note = document.getElementById('wwp-gps-note');
  if (!btn) return;

  btn.addEventListener('click', function () {
    if (!navigator.geolocation) return;

    note.textContent = 'Reading position…';

    navigator.geolocation.getCurrentPosition(function (pos) {
      var lat = pos.coords.latitude, lng = pos.coords.longitude;

      if (lat < -2.6 || lat > -1.0 || lng < 29.0 || lng > 31.0) {
        note.textContent = 'That position is outside Kigali — not recorded.';
        return;
      }

      document.getElementById('wwp-lat').value = lat.toFixed(7);
      document.getElementById('wwp-lng').value = lng.toFixed(7);
      note.textContent = 'Position captured.';
    }, function () {
      note.textContent = 'Could not read the position. Type the coordinates if known.';
    }, { enableHighAccuracy: true, timeout: 12000 });
  });
})();

/* Add / remove UPI rows. */
(function () {
  var list = document.getElementById('upi-list');
  var addBtn = document.getElementById('upi-add');
  if (!list || !addBtn) return;

  addBtn.addEventListener('click', function () {
    if (list.children.length >= 6) return;
    var row = document.createElement('div');
    row.className = 'wwp-upi-row';
    row.innerHTML = '<input type="text" class="wwp-in" name="upis[]" placeholder="1/02/05/03/4745">' +
      '<button type="button" class="btn btn-ghost btn-sm wwp-upi-remove">Remove</button>';
    list.appendChild(row);
  });

  list.addEventListener('click', function (e) {
    if (e.target.classList.contains('wwp-upi-remove')) {
      e.target.closest('.wwp-upi-row').remove();
    }
  });
})();

/* ---------- Team ---------- */
(function () {
  var list = document.getElementById('team-list');
  var userOptionsHtml = document.querySelector('.team-user').innerHTML;
  var positionOptionsHtml = document.querySelector('.team-position').innerHTML;

  /* Selecting a real account fills position and institution from that
     account, and disables both fields — a disabled field posts nothing,
     so what reaches the server is exactly what the account says, never
     something typed differently by mistake. "Not on this platform"
     re-enables both, since an external colleague's role is not on file
     anywhere for the platform to fill in. */
  function applyRow(row) {
    var select = row.querySelector('.team-user');
    var name   = row.querySelector('.team-other-name');
    var pos    = row.querySelector('.team-position');
    var inst   = row.querySelector('.team-institution');
    var note   = row.querySelector('.team-account-note');
    var chosen = select.options[select.selectedIndex];
    var isUser = !!select.value;

    name.style.display = isUser ? 'none' : '';
    if (isUser) name.value = '';

    pos.disabled = isUser;
    inst.disabled = isUser;
    note.style.display = isUser ? '' : 'none';

    if (isUser) {
      var wantedPos = chosen.dataset.position || '';
      Array.from(pos.options).forEach(function (o) { o.selected = o.value === wantedPos; });
      inst.value = chosen.dataset.institution || 'City of Kigali';
    }
  }

  list.addEventListener('change', function (e) {
    if (e.target.classList.contains('team-user')) applyRow(e.target.closest('.team-row'));
  });

  document.getElementById('team-add').addEventListener('click', function () {
    var n = list.querySelectorAll('.team-row').length;
    if (n >= 8) return;
    var row = document.createElement('div');
    row.className = 'team-row';
    row.innerHTML =
      '<select class="fi team-user" name="team[' + n + '][user_id]">' + userOptionsHtml + '</select>' +
      '<input class="fi team-other-name" name="team[' + n + '][name]" placeholder="Full name">' +
      '<select class="fi team-position" name="team[' + n + '][position]">' + positionOptionsHtml + '</select>' +
      '<input class="fi team-institution" name="team[' + n + '][institution]" placeholder="Institution" value="City of Kigali">' +
      '<div class="team-account-note" style="display:none">From account &mdash; position and institution follow it automatically</div>' +
      '<button type="button" class="btn btn-ghost btn-sm team-remove">&times;</button>';
    list.appendChild(row);
  });

  list.addEventListener('click', function (e) {
    if (e.target.classList.contains('team-remove') && list.querySelectorAll('.team-row').length > 1) {
      e.target.closest('.team-row').remove();
    }
  });
})();

/* ---------- Photos ---------- */
(function () {
  const MAX = 3;
  const preview = document.getElementById('photo-preview');
  let chosen = [];
  document.querySelectorAll('.photo-input').forEach(input => {
    input.addEventListener('change', () => {
      Array.from(input.files).forEach(f => {
        if (chosen.length >= MAX) return;
        chosen.push(f);
      });
      render();
    });
  });
  function render() {
    preview.innerHTML = '';
    chosen.forEach((f, i) => {
      const d = document.createElement('div');
      d.className = 'ph-thumb';
      const img = document.createElement('img');
      img.src = URL.createObjectURL(f);
      const cap = document.createElement('div');
      cap.className = 'ph-name';
      cap.textContent = f.name;
      const rm = document.createElement('div');
      rm.className = 'ph-del';
      rm.textContent = 'Remove';
      rm.onclick = () => { chosen.splice(i, 1); render(); sync(); };
      d.append(img, cap, rm);
      preview.appendChild(d);
    });
    sync();
  }
  function sync() {
    const dt = new DataTransfer();
    chosen.forEach(f => dt.items.add(f));
    const first = document.querySelector('.photo-input');
    first.files = dt.files;
    document.querySelectorAll('.photo-input').forEach((el, i) => { if (i > 0) el.value = ''; });
  }
})();

/* Building Use posts to the shared use_type field as the label text
   itself, not a short key. "Other" swaps in the free-text box's value
   instead of the literal word "Other". */
(function () {
  var select = document.getElementById('use_type_select');
  var hidden = document.getElementById('use_type_hidden');
  var other  = document.getElementById('use_type_other');
  if (!select || !hidden || !other) return;

  var known = Array.from(select.options).some(function (o) { return o.value === hidden.value; });
  if (hidden.value && !known) {
    select.value = '';
    other.style.display = '';
  }

  function sync2() {
    if (select.value === 'Other') {
      other.style.display = '';
      hidden.value = other.value;
    } else {
      other.style.display = 'none';
      hidden.value = select.value;
    }
  }

  select.addEventListener('change', sync2);
  other.addEventListener('input', function () { hidden.value = other.value; });
})();
</script>
@endpush 