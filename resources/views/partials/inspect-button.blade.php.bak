{{--
  Starting an inspection.

  One entry point rather than a button per category. The three places
  this replaces were all hard-coded to petrol stations, so an inspector
  choosing Add File got a filling station whichever category they had in
  mind.

  Categories without a published checklist are shown but not offered:
  the unit's remit is wider than what the platform can yet score, and
  hiding that would misrepresent it.
--}}

@can('inspection.create')
@php
  $groups = config('inspection_types.groups', []);

  $ready = collect($groups)->flatMap(fn ($g) => collect($g['types'])->filter(fn ($t) => $t['live']))->count();
@endphp

<button type="button" class="btn btn-success" id="inspect-btn">Inspect</button>

<div class="ins-veil" id="inspect-veil" role="dialog" aria-modal="true" aria-label="Choose an inspection">
  <div class="ins-box">
    <div class="ins-head">
      <div>
        <h3>What are you inspecting?</h3>
        <div class="ins-sub">
          {{ $ready }} {{ Str::plural('category', $ready) }} ready.
          Choose one to open a premises file.
        </div>
      </div>
      <button type="button" class="ins-x" id="inspect-close" aria-label="Close">&times;</button>
    </div>

    <div class="ins-body">
      @foreach($groups as $key => $group)
        <div class="ins-group">{{ $group['label'] }}</div>
        <div class="ins-grid">
          @foreach($group['types'] as $code => $t)
            @if($t['live'])
              <a href="{{ route('entity.add', $code) }}" class="ins-card">
                <b>{{ $t['name'] }}</b>
                <span>{{ Str::limit($t['blurb'] ?? '', 70) }}</span>
              </a>
            @else
              <div class="ins-card off" title="No published checklist yet">
                <b>{{ $t['name'] }}</b>
                <span>Checklist not yet published</span>
              </div>
            @endif
          @endforeach
        </div>
      @endforeach
    </div>
  </div>
</div>

@push('styles')
<style>
  .ins-veil{display:none;position:fixed;inset:0;z-index:500;background:rgba(51,51,51,.55);
            padding:5vh 20px;overflow-y:auto}
  .ins-veil.on{display:block}
  .ins-box{max-width:820px;margin:0 auto;background:var(--white);box-shadow:var(--shadow)}

  .ins-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;
            padding:22px 26px;border-bottom:1px solid var(--border)}
  .ins-head h3{font-family:var(--f-head);font-size:19px;font-weight:700;color:var(--ink);margin:0}
  .ins-sub{font-size:13px;color:var(--body-text);margin-top:3px}
  .ins-x{border:0;background:none;font-size:26px;line-height:1;color:var(--tertiary);
         cursor:pointer;padding:0 4px}
  .ins-x:hover{color:var(--danger)}

  .ins-body{padding:6px 26px 26px}
  .ins-group{font-family:var(--f-head);font-size:10px;font-weight:600;letter-spacing:1.1px;
             text-transform:uppercase;color:var(--tertiary);margin:20px 0 10px;
             padding-bottom:6px;border-bottom:1px solid var(--border)}
  .ins-grid{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}

  .ins-card{display:block;padding:14px 16px;background:var(--canvas);text-decoration:none;
            border-left:3px solid var(--success);transition:all .18s}
  .ins-card:hover{background:var(--white);box-shadow:var(--shadow-sm);transform:translateY(-2px)}
  .ins-card b{display:block;font-family:var(--f-head);font-size:14px;font-weight:600;
              color:var(--ink);margin-bottom:3px}
  .ins-card span{display:block;font-size:11.5px;color:var(--body-text);line-height:1.5}
  .ins-card.off{border-left-color:var(--border);opacity:.55;cursor:not-allowed}
  .ins-card.off span{font-style:italic;color:var(--tertiary)}

  @media(max-width:640px){
    .ins-veil{padding:0}
    .ins-box{min-height:100vh}
    .ins-grid{grid-template-columns:1fr}
  }
  @media print{.ins-veil{display:none!important}}
</style>
@endpush

@push('scripts')
<script>
/* The chooser, in its own closure so a fault elsewhere on the page
   cannot stop an inspector starting work. */
(function () {
  var btn   = document.getElementById('inspect-btn');
  var veil  = document.getElementById('inspect-veil');
  var close = document.getElementById('inspect-close');
  if (!btn || !veil) return;

  function show(on) {
    veil.classList.toggle('on', on);
    document.body.style.overflow = on ? 'hidden' : '';
  }

  btn.addEventListener('click', function () { show(true); });
  if (close) close.addEventListener('click', function () { show(false); });

  /* Clicking the backdrop closes; clicking a card does not. */
  veil.addEventListener('click', function (e) { if (e.target === veil) show(false); });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && veil.classList.contains('on')) show(false);
  });
})();
</script>
@endpush
@endcan