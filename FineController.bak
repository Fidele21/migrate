<?php

namespace App\Http\Controllers;

use App\Models\Document;
use App\Models\Fine;
use App\Models\FinePayment;
use App\Models\Inspection;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

/**
 * Penalties.
 *
 * Proposed by an inspector, director, senior inspector or the secretary;
 * confirmed by a Senior or Chief Inspector; settled against by the
 * Recovery Officer. A fine is payable only once confirmed.
 */
class FineController extends Controller
{
        /**
     * The fine register, with what is owed at each stage.
     *
     * The figures are amounts rather than counts. How many fines are
     * outstanding matters less than how much — a register showing "8
     * pending" tells the Chief Inspector nothing about whether that is
     * two hundred thousand francs or twelve million.
     */
    public function index(Request $request)
    {
        $user = auth()->user();
        abort_unless($user->can('fine.view'), 403);

        $filters = [
            'status'   => $request->query('status'),
            'district' => $request->query('district'),
            'from'     => $request->query('from'),
            'to'       => $request->query('to'),
            'q'        => trim((string) $request->query('q', '')),
        ];

        $query = Fine::with(['entity', 'proposer', 'confirmer', 'inspection.faults.fault', 'document'])
            ->orderByRaw("FIELD(status,'confirmed','part_paid','proposed','paid','waived','cancelled')")
            ->orderBy('due_date');

        if (! $user->can('inspection.view.all')) {
            $query->where('district_id', $user->district_id);
        }

        if ($filters['district']) {
            $query->whereHas('entity', fn ($q) => $q->where('district', $filters['district']));
        }

        if ($filters['from']) {
            $query->whereDate('proposed_at', '>=', $filters['from']);
        }

        if ($filters['to']) {
            $query->whereDate('proposed_at', '<=', $filters['to']);
        }

        if ($filters['q']) {
            $term = $filters['q'];
            $query->where(fn ($w) => $w
                ->where('reference', 'like', "%{$term}%")
                ->orWhereHas('entity', fn ($q) => $q
                    ->where('name', 'like', "%{$term}%")
                    ->orWhere('owner', 'like', "%{$term}%")
                    ->orWhere('upi', 'like', "%{$term}%")
                    ->orWhere('telephone', 'like', "%{$term}%")));
        }

        /* Every fine in scope, before the status filter — the figures
           above the list describe the whole register, and a filtered
           total sitting under an unfiltered heading would mislead. */
        $all = (clone $query)->get();

        if ($filters['status']) {
            $query->where('status', $filters['status']);
        }

        $fines = $query->get();

        $confirmed = $all->whereIn('status', [Fine::CONFIRMED, Fine::PART_PAID]);

        return view('fine.index', [
            'fines'   => $fines,
            'filters' => $filters,
            'active'  => collect($filters)->filter()->count(),

            'figures' => [
                /* What the schedule sets against faults recorded but not
                   yet proposed as a fine. The work waiting to be done. */
                'unraised' => $this->unraisedTotal($user),

                'proposed' => (float) $all->where('status', Fine::PROPOSED)->sum('amount'),
                'approved' => (float) $confirmed->sum('amount'),
                'paid'     => (float) $all->sum('amount_paid'),
                'pending'  => (float) $confirmed->reject->isOverdue()->sum(fn ($f) => $f->outstanding()),
                'overdue'  => (float) $confirmed->filter->isOverdue()->sum(fn ($f) => $f->outstanding()),
            ],

            'counts' => [
                'proposed' => $all->where('status', Fine::PROPOSED)->count(),
                'approved' => $confirmed->count(),
                'paid'     => $all->whereIn('status', [Fine::PAID, Fine::PART_PAID])->count(),
                'pending'  => $confirmed->reject->isOverdue()->count(),
                'overdue'  => $confirmed->filter->isOverdue()->count(),
            ],

            'canConfirm' => $user->can('fine.confirm'),
            'canRecord'  => $user->can('fine.payment.update'),
            'canExport'  => $user->can('export.excel') || $user->can('fine.view'),
        ]);
    }

    /**
     * Faults recorded against inspections that have not become a fine.
     *
     * Shown so the Chief Inspector can see what the schedule sets which
     * nobody has yet acted on. A fault found and never fined is the same
     * to the premises as a fault never found.
     */
    private function unraisedTotal($user): float
    {
        $q = \App\Models\InspectionFault::query()
            ->whereDoesntHave('inspection.fines')
            ->whereNotNull('amount');

        if (! $user->can('inspection.view.all')) {
            $q->whereHas('inspection', fn ($i) => $i->where('district_id', $user->district_id));
        }

        return (float) $q->sum('amount');
    }

    public function create(Request $request)
    {
        abort_unless(auth()->user()->can('fine.suggest'), 403);

        $inspection = $request->filled('inspection')
            ? Inspection::with('entity')->find($request->integer('inspection'))
            : null;

        $letter = $request->filled('letter')
            ? Document::find($request->integer('letter'))
            : null;

        return view('fine.form', compact('inspection', 'letter'));
    }

    public function store(Request $request)
    {
        abort_unless(auth()->user()->can('fine.suggest'), 403);

        $data = $request->validate([
            'inspection_id' => ['required', 'exists:inspections,id'],
            'document_id'   => ['nullable', 'exists:documents,id'],
            'amount'        => ['required', 'numeric', 'min:1', 'max:999999999'],
            'reason'        => ['required', 'string', 'min:10', 'max:2000'],
            'legal_basis'   => ['nullable', 'string', 'max:255'],
            'due_date'      => ['nullable', 'date', 'after:today'],
        ], [
            'reason.min'      => 'Give enough detail for the Chief Inspector to judge the proposal.',
            'due_date.after'  => 'The due date must be in the future.',
        ]);

        $inspection = Inspection::findOrFail($data['inspection_id']);

        $fine = Fine::create([
            'inspection_id' => $inspection->id,
            'document_id'   => $data['document_id'] ?? null,
            'entity_id'     => $inspection->entity_id,
            'district_id'   => $inspection->district_id,
            'status'        => Fine::PROPOSED,
            'amount'        => $data['amount'],
            'reason'        => $data['reason'],
            'legal_basis'   => $data['legal_basis'] ?? null,
            'due_date'      => $data['due_date'] ?? null,
            'proposed_by'   => auth()->id(),
            'proposed_at'   => now(),
            'case_reference' => $inspection->case_reference,
        ]);

        return redirect()->route('fine.show', $fine)
            ->with('status', 'Fine proposed. It becomes payable once confirmed.');
    }

    public function show(Fine $fine)
    {
        abort_unless(auth()->user()->can('fine.view'), 403);

        return view('fine.show', [
            'fine'       => $fine->load(['entity', 'inspection', 'document', 'proposer', 'confirmer', 'payments.recorder']),
            'canConfirm' => auth()->user()->can('fine.confirm') && $fine->status === Fine::PROPOSED,
            'canRecord'  => auth()->user()->can('fine.payment.update') && $fine->isPayable(),
        ]);
    }

    /** Senior or Chief Inspector confirms, adjusts or cancels. */
    public function confirm(Request $request, Fine $fine)
    {
        abort_unless(auth()->user()->can('fine.confirm'), 403);
        abort_unless($fine->status === Fine::PROPOSED, 422, 'This fine has already been decided.');

        $data = $request->validate([
            'decision' => ['required', 'in:confirm,waive,cancel'],
            'amount'   => ['required_if:decision,confirm', 'nullable', 'numeric', 'min:1'],
            'due_date' => ['nullable', 'date', 'after:today'],
            'note'     => ['nullable', 'string', 'max:1000'],
        ]);

        $fine->forceFill([
            'status' => match ($data['decision']) {
                'confirm' => Fine::CONFIRMED,
                'waive'   => Fine::WAIVED,
                'cancel'  => Fine::CANCELLED,
            },
            'amount'       => $data['decision'] === 'confirm' ? $data['amount'] : $fine->amount,
            'due_date'     => $data['due_date'] ?? $fine->due_date,
            'confirmed_by' => auth()->id(),
            'confirmed_at' => now(),
            'confirm_note' => $data['note'] ?? null,
            'reference'      => $fine->reference ?: $this->fineReference($fine),
            'case_reference' => $fine->case_reference ?: $fine->inspection?->case_reference,
        ])->save();

        return redirect()->route('fine.show', $fine)->with('status', match ($data['decision']) {
            'confirm' => 'Fine confirmed and now payable.',
            'waive'   => 'Fine waived.',
            'cancel'  => 'Fine cancelled.',
        });
    }

    /**
     * Propose a fine from the faults found at an inspection.
     *
     * The amount comes from the sanctions schedule rather than from
     * memory: an officer who types a figure is exercising a judgement the
     * schedule has already made, and two officers would type different
     * numbers for the same fault.
     *
     * The form still opens for editing before it is proposed. What
     * changes is the starting point.
     */
    public function fromFaults(Inspection $inspection)
    {
        abort_unless(auth()->user()->can('fine.suggest'), 403);

        $inspection->load('faults.fault', 'entity');

        abort_if($inspection->faults->isEmpty(), 422,
            'No faults were recorded at this inspection, so there is nothing to fine.');

        /* Nothing is owed until a letter issues, but a proposal may be
           prepared once the report is sealed — the letter then states a
           figure the platform already holds rather than one typed into it
           and reconciled afterwards. */
        abort_unless($inspection->hasSealedReport(), 422,
            'The report must be signed and sealed before a fine can be proposed.');

        $priced = $inspection->faults->filter(fn ($f) => $f->amount > 0);

        $reason = $inspection->faults->map(function ($f, $i) {
            $line = ($i + 1) . '. ' . ($f->fault?->title ?? 'Fault');

            if ($f->scope) {
                $line .= ' (' . $f->scope . ')';
            }

            $line .= ' — ' . ($f->amount
                ? 'FRW ' . number_format((float) $f->amount, 0)
                : 'no fine; ' . strtolower(rtrim($f->action ?? 'action as scheduled', '.')));

            return $f->note ? $line . '. ' . $f->note : $line;
        })->implode("\n");

        return view('fine.form', [
            'inspection' => $inspection,
            'entity'     => $inspection->entity,
            'prefill'    => [
                'amount'      => (float) $priced->sum('amount'),
                'reason'      => "Faults found at the inspection of "
                                 . $inspection->entity->name . " on "
                                 . $inspection->inspection_date->format('j F Y')
                                 . ":\n\n" . $reason,
                'legal_basis' => 'Administrative sanctions schedule, Urban Planning Code',
                'due_date'    => now()->addDays(30)->format('Y-m-d'),
            ],
            'unpriced'   => $inspection->faults->filter(fn ($f) => ! $f->amount),
        ]);
    }


    /** Recovery Officer records a payment received. */
    public function pay(Request $request, Fine $fine)
    {
        abort_unless(auth()->user()->can('fine.payment.update'), 403);
        abort_unless($fine->isPayable(), 422, 'This fine is not currently payable.');

        $data = $request->validate([
            'amount'    => ['required', 'numeric', 'min:1', 'max:' . $fine->outstanding()],
            'paid_on'   => ['required', 'date', 'before_or_equal:today'],
            'method'    => ['required', 'string', 'max:40'],
            'reference' => ['nullable', 'string', 'max:80'],
            'note'      => ['nullable', 'string', 'max:500'],
        ], [
            'amount.max' => 'That is more than the outstanding balance of '
                            . number_format($fine->outstanding()) . ' RWF.',
        ]);

        DB::transaction(function () use ($fine, $data) {
            FinePayment::create([
                'fine_id'     => $fine->id,
                'amount'      => $data['amount'],
                'paid_on'     => $data['paid_on'],
                'method'      => $data['method'],
                'reference'   => $data['reference'] ?? null,
                'note'        => $data['note'] ?? null,
                'recorded_by' => auth()->id(),
            ]);

            $fine->recorded_by = auth()->id();
            $fine->refreshSettlement();
        });

        return redirect()->route('fine.show', $fine)->with('status',
            number_format((float) $data['amount']) . ' RWF recorded. '
            . ($fine->fresh()->status === Fine::PAID
                ? 'The fine is now settled in full.'
                : number_format($fine->fresh()->outstanding()) . ' RWF remains outstanding.'));
    }

    /**
     * A fine belongs to a case. Where the case already has a registry
     * reference it is used, with a suffix so several fines on one case
     * remain distinguishable. Otherwise a standalone number is issued
     * and it joins the case when the letter is referenced.
     */
    private function fineReference(Fine $fine): string
    {
        $case = $fine->inspection?->case_reference;

        if ($case) {
            $n = Fine::where('inspection_id', $fine->inspection_id)
                     ->whereNotNull('reference')->count() + 1;

            return $n > 1 ? $case . '-F' . $n : $case;
        }

        $n = Fine::whereNotNull('reference')->count() + 1;

        return 'CoK/FINE/' . now()->format('Y') . '/' . str_pad((string) $n, 4, '0', STR_PAD_LEFT);
    }
}
