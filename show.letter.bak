    <span class="u-bold">KIGALI</span>
  </div>

  <div class="l-subject"><span class="u-bold">Impamvu</span>: {{ $letter->subject }}</div>

  <div class="l-salut">{{ $cfg['salutation'][$letter->salutation ?? 'company'] }}</div>

  @foreach($type['body'] as $clause)
    @if($clause === 'requirements' && $failed->count())
      <p class="l-body">{{ $sub($cfg['clauses']['requirements']) }}</p>
      <ol class="l-reqs">
        @foreach($failed as $label)<li>{{ rtrim($label, '. ') }};</li>@endforeach
      </ol>
    @else
      <p class="l-body">{{ $sub($cfg['clauses'][$clause] ?? '') }}</p>
    @endif
  @endforeach

  @if($letter->body_html)
    <p class="l-body">{!! nl2br(e(strip_tags($letter->body_html))) !!}</p>
  @endif

  <div class="l-closing">{{ $cfg['closing'] }}</div>

  <div class="l-sig">
    @if($signatory?->signature_path && $letter->signatures->count())
      <img src="{{ Storage::disk('public')->url($signatory->signature_path) }}"
           alt="Signature" class="sig-img">
    @endif
    <strong>{{ $signatory?->name ?? '' }}</strong><br>
    <strong>{{ $cfg['signatory']['title'] }}</strong>
    @if($letter->signatures->count())
      <div class="signed">Signed {{ $letter->signatures->first()->signed_at->format('j F Y, H:i') }}</div>
    @endif
  </div>

  <div class="l-copies">
    <span class="u-bold">Bimenyeshejwe:</span>
    @foreach($cfg['copies'] as $line)
      <div>- {{ strtr($line, [':district' => $e?->district ?? '']) }}</div>
    @endforeach
  </div>

  <div class="u-bold" style="margin-top:22px">KIGALI</div>
@endif
</section>

