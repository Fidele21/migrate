  <script>
  (function () {
    var list = document.getElementById('team-list');
    var posHtml = document.querySelector('#team-list select').innerHTML;

    document.getElementById('team-add').addEventListener('click', function () {
      var n = list.querySelectorAll('.team-row').length;
      if (n >= 8) return;
      var row = document.createElement('div');
      row.className = 'team-row';
      row.innerHTML =
        '<input class="fi" name="team[' + n + '][name]" placeholder="Full name">' +
        '<select class="fi" name="team[' + n + '][position]">' + posHtml + '</select>' +
        '<input class="fi" name="team[' + n + '][institution]" placeholder="Institution" value="City of Kigali">' +
        '<button type="button" class="btn btn-ghost btn-sm team-remove">&times;</button>';
      list.appendChild(row);
    });

    list.addEventListener('click', function (e) {
      if (e.target.classList.contains('team-remove') && list.querySelectorAll('.team-row').length > 1) {
        e.target.closest('.team-row').remove();
      }
    });
  })();
  </script>

