<script>
/* The stage decides which checklist applies. The set not in use is
   disabled as well as hidden: a hidden input still posts, and an officer
   who switched stages mid-form would otherwise submit answers to
   questions they never saw. */
(function () {
  var sel  = document.getElementById('building_status');
  var sets = document.querySelectorAll('.stage-set');
  if (!sel || sets.length < 2) return;

  function apply() {
    sets.forEach(function (set) {
      var on = set.dataset.stage === sel.value;
      set.style.display = on ? '' : 'none';
      set.querySelectorAll('input, select, textarea').forEach(function (el) {
        el.disabled = ! on;
      });
    });
  }

  sel.addEventListener('change', apply);
  apply();
})();

/* ---------- GPS ---------- */
(function () {
  var lat  = document.getElementById('latitude');
  var lng  = document.getElementById('longitude');
  var note = document.getElementById('gps-note');
  var btn  = document.getElementById('gps-capture');

  /* Kigali sits between roughly -2.10 and -1.85 latitude, 29.95 and
     30.20 longitude. A value far outside that is a typing slip — most
     often the two swapped, or a missing minus sign. */
  function check() {
    var a = parseFloat(lat.value), b = parseFloat(lng.value);
    if (isNaN(a) && isNaN(b)) { note.className = 'gps-note'; note.textContent = 'Capture uses this device\'s position, or type the coordinates if you have them.'; return; }

    if (isNaN(a) || isNaN(b)) {
      note.className = 'gps-note bad';
      note.textContent = 'Both latitude and longitude are needed.';
      return;
    }

    if (a > 0 && b < 0) {
      note.className = 'gps-note bad';
      note.textContent = 'These look swapped. In Kigali latitude is negative, longitude positive.';
      return;
    }

    if (a < -2.4 || a > -1.6 || b < 29.6 || b > 30.5) {
      note.className = 'gps-note bad';
      note.textContent = 'That position is outside Kigali. Check the figures.';
      return;
    }

    note.className = 'gps-note ok';
    note.textContent = 'Position accepted.';
  }

  lat.addEventListener('input', check);
  lng.addEventListener('input', check);
  check();

  btn.addEventListener('click', function () {
    if (!navigator.geolocation) {
      note.className = 'gps-note bad';
      note.textContent = 'This device cannot report its position. Type the coordinates instead.';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Locating…';
    note.className = 'gps-note';
    note.textContent = 'Reading position…';

    navigator.geolocation.getCurrentPosition(function (p) {
      lat.value = p.coords.latitude.toFixed(6);
      lng.value = p.coords.longitude.toFixed(6);
      btn.disabled = false;
      btn.textContent = 'Capture';
      check();
      note.textContent = 'Captured to within about ' + Math.round(p.coords.accuracy) + ' m.';
    }, function () {
      btn.disabled = false;
      btn.textContent = 'Capture';
      note.className = 'gps-note bad';
      note.textContent = 'Could not read the position. Type the coordinates instead.';
    }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 });
  });
})();
</script>

@endsection

@push('styles')
<style>
    .team-row{display:grid;grid-template-columns:1.1fr 1.4fr 1fr auto;gap:9px;margin-bottom:9px;align-items:center}
    @media(max-width:760px){.team-row{grid-template-columns:1fr}}
    .team-row:first-child .team-remove{visibility:hidden}
  </style>
<style>
  /* ---- Step sections ---- */
  .step{background:#fff;border:1px solid var(--line);border-radius:10px;margin-bottom:18px;
        box-shadow:var(--sh);overflow:hidden}
  .step-bar{background:var(--blue);color:#fff;padding:13px 20px;font-size:14.5px;font-weight:700;
            letter-spacing:-.01em;display:flex;align-items:center;gap:11px}
  .step-no{display:inline-flex;align-items:center;justify-content:center;width:25px;height:25px;
           border-radius:6px;background:var(--gold);color:var(--blue);font-size:13px;font-weight:800}
  .opt{margin-left:auto;font-size:11px;font-weight:600;opacity:.85;letter-spacing:.03em}
  .step-body{padding:20px 22px}

  .sub-head{font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;
            color:var(--blue);margin:22px 0 12px;padding-bottom:6px;border-bottom:1px solid var(--line);
            display:flex;align-items:baseline;gap:10px}
  .sub-note{font-size:10.5px;font-weight:500;text-transform:none;letter-spacing:0;color:var(--muted)}

  /* ---- Fields ---- */
  .fgrid{display:grid;gap:15px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
  .fgrid .f2{grid-column:span 2}
  @media(max-width:660px){.fgrid .f2{grid-column:span 1}}
  .fl{display:block;font-size:10.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;
      color:var(--muted);margin-bottom:5px}
  .req{color:var(--red)}
  .fi{width:100%;padding:10px 12px;border:1px solid #D3D8E0;border-radius:7px;
      font-size:14px;font-family:inherit;background:#fff;color:var(--ink)}
  .fi:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,51,160,.11)}
  .fi:invalid:not(:placeholder-shown){border-color:var(--red)}
  .fi.sm{padding:7px 10px;font-size:12.5px}
  textarea.fi{resize:vertical;line-height:1.6}
  .hint{font-size:11.5px;color:var(--muted);margin-top:5px}

  /* ---- UPI rows ---- */
  .upi-row{display:flex;gap:8px;margin-bottom:8px;align-items:center}
  .upi-input{font-variant-numeric:tabular-nums;letter-spacing:.02em}
  .upi-remove{padding:8px 12px;font-size:16px;line-height:1;color:var(--muted)}
  .upi-row:first-child .upi-remove{visibility:hidden}
  .upi-tools{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:4px}
  .upi-warn{color:#8A6D00;font-weight:600}

  /* ---- Progress ---- */
  .progress-bar{position:sticky;top:var(--topbar-h);z-index:60;background:#fff;
    border:1px solid var(--line);border-radius:10px;padding:12px 18px;margin-bottom:16px;
    display:flex;align-items:center;gap:16px;flex-wrap:wrap;box-shadow:var(--sh)}
  .pb-left{font-size:12.5px;color:var(--muted);white-space:nowrap}
  .pb-track{flex:1;min-width:110px;height:8px;background:#EEF1F5;border-radius:5px;overflow:hidden}
  .pb-fill{height:100%;width:0;background:var(--blue);border-radius:5px;transition:width .3s}
  .pb-right{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
  .tally{font-size:11px;font-weight:600;color:var(--muted)}
  .tally b{font-size:13px;margin-left:3px}
  .tally.yes b{color:var(--green)} .tally.no b{color:var(--red)} .tally.na b{color:var(--muted)}
  .score{font-size:16px;font-weight:800;color:var(--blue);font-variant-numeric:tabular-nums}

  /* ---- Checklist ---- */
  .chk-section{background:#fff;border:1px solid var(--line);border-radius:10px;
               margin-bottom:16px;box-shadow:var(--sh);overflow:hidden;padding:0 0 6px}
  .sec-head{display:flex;justify-content:space-between;align-items:center;gap:12px;
    background:#EDF2FC;color:var(--blue);padding:12px 20px;font-size:13.5px;font-weight:700;
    border-bottom:1px solid #DCE5F7}
  .sec-no{display:inline-flex;align-items:center;justify-content:center;width:23px;height:23px;
    border-radius:6px;background:var(--blue);color:#fff;font-size:11.5px;margin-right:9px}
  .sec-count{font-size:11.5px;font-weight:700;color:var(--muted);font-variant-numeric:tabular-nums}
  .chk-item{display:grid;grid-template-columns:1fr auto;gap:8px 16px;padding:12px 20px;
            border-top:1px solid #F1F3F6;align-items:start}
  .chk-item:first-of-type{border-top:none}
  .chk-item.carried{background:#FEFBF2}
  .ci-label{font-size:13.5px;line-height:1.5}
  .wt{display:inline-block;margin-left:8px;font-size:10px;font-weight:800;color:var(--blue);
      background:#EDF2FC;padding:1px 7px;border-radius:10px;vertical-align:1px}
  .carried-tag{display:inline-block;margin-left:7px;font-size:9.5px;font-weight:800;
    letter-spacing:.05em;text-transform:uppercase;color:#8A6D00;background:#FFF4D6;
    padding:2px 7px;border-radius:10px;vertical-align:1px}
  .ci-status{display:flex;gap:5px}
  .ci-comment{grid-column:1/-1}
  .sbtn{border:1px solid #D3D8E0;background:#fff;color:var(--muted);font-size:11px;font-weight:700;
        padding:7px 14px;border-radius:6px;cursor:pointer;min-width:48px;text-align:center;
        transition:all .12s;user-select:none}
  .sbtn input{position:absolute;opacity:0;width:0;height:0}
  .sbtn:hover{background:#F6F8FB}
  .sbtn.s-yes.on{background:#E4F5EA;border-color:var(--green);color:#00612B}
  .sbtn.s-no.on {background:#FDE8E6;border-color:var(--red);color:var(--red)}
  .sbtn.s-na.on {background:#F1F3F6;border-color:#9AA1AC;color:#4A5361}

  /* ---- Photos ---- */
  .photo-drop{border:2px dashed #D3D8E0;border-radius:10px;padding:22px;text-align:center;background:#FAFBFC}
  .pd-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:10px}
  .pd-actions .btn{cursor:pointer}
  .pd-note{font-size:11.5px;color:var(--muted)}
  .photo-preview,.photo-existing{display:flex;gap:12px;flex-wrap:wrap;margin-top:16px;justify-content:center}
  .ph-thumb{width:132px;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff}
  .ph-thumb img{width:100%;height:96px;object-fit:cover;display:block}
  .ph-del{display:block;padding:6px;font-size:11px;color:var(--red);cursor:pointer;text-align:center}
  .ph-name{padding:6px;font-size:10.5px;color:var(--muted);text-align:center;
           white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
           
    
    .prohibited{display:inline-block;margin-left:8px;font-size:9.5px;font-weight:800;
    letter-spacing:.05em;text-transform:uppercase;color:#B71C1C;background:#FDECEA;
    padding:2px 7px;vertical-align:1px}

  /* ---- Save bar ---- */
  .save-bar{position:sticky;bottom:0;background:#fff;border:1px solid var(--line);
    border-radius:10px;padding:14px 20px;display:flex;justify-content:space-between;
    align-items:center;gap:16px;flex-wrap:wrap;box-shadow:0 -3px 14px rgba(16,24,40,.07)}
  .sb-note{font-size:12px;color:var(--muted);flex:1;min-width:200px}
  .sb-actions{display:flex;gap:9px}

  @media(max-width:700px){
    .chk-item{grid-template-columns:1fr}
    .ci-status{justify-content:flex-start}
    .progress-bar{position:static}
    .step-body{padding:16px 14px}
  }
</style>
<style>
  .chk-item.unanswered{background:#FFF6F5;box-shadow:inset 3px 0 0 var(--red)}
  .chk-item.unanswered .ci-label{font-weight:600}
  .sec-head.has-gap{background:#FDECEA;color:var(--red);border-bottom-color:#F6C9C4}
  .sec-head.has-gap .sec-no{background:var(--red)}
  .gap-banner{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);
    background:var(--red);color:#fff;padding:12px 20px;border-radius:9px;font-size:13.5px;
    font-weight:600;box-shadow:0 6px 20px rgba(0,0,0,.22);z-index:200;max-width:90vw;
    display:none;align-items:center;gap:14px}
  .gap-banner button{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.4);
    color:#fff;border-radius:6px;padding:5px 12px;font:600 12px inherit;font-family:inherit;cursor:pointer}
</style>
<style>
  .chk-item.unanswered{background:#FFF6F5;box-shadow:inset 3px 0 0 var(--red)}
  .chk-item.unanswered .ci-status .sbtn{border-color:#EFA9A1}
  .item-flag{display:block;margin-top:6px;font-size:11.5px;font-weight:600;color:var(--red)}
  .sec-head.has-gap{background:#FDECEA;color:var(--red);border-bottom-color:#F6C9C4}
  .sec-head.has-gap .sec-no{background:var(--red)}

  /* New GPS styles */
  .gps-block{margin-bottom:18px}
  .gps-row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}
  .gps-field{flex:1;min-width:130px}
  .gps-field span{display:block;font-family:var(--f-head);font-size:9.5px;font-weight:600;
                  letter-spacing:.8px;text-transform:uppercase;color:var(--tertiary);margin-bottom:5px}
  .gps-note{font-size:12px;color:var(--body-text);margin-top:7px}
  .gps-note.bad{color:var(--danger)}
  .gps-note.ok{color:var(--success)}
</style>
@endpush