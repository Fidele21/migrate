<script>
const KIGALI = @json(config('kigali'));

/* ---------- Cascading location ---------- */
(function () {
  const dEl = document.getElementById('district');
  const sEl = document.getElementById('sector');
  const cEl = document.getElementById('cell');

  const savedSector = @json(old('sector', $entity->sector ?? ''));
  const savedCell   = @json(old('cell', $entity->cell ?? ''));

  function fill(select, values, selected, placeholder) {
    select.innerHTML = '<option value="">' + placeholder + '</option>';
    values.forEach(v => {
      const o = document.createElement('option');
      o.value = v; o.textContent = v;
      if (v === selected) o.selected = true;
      select.appendChild(o);
    });
    select.disabled = values.length === 0;
  }

  function onDistrict(keepSector) {
    const sectors = KIGALI[dEl.value] ? Object.keys(KIGALI[dEl.value]) : [];
    fill(sEl, sectors, keepSector ? savedSector : '', 'Select sector');
    onSector(keepSector);
  }

  function onSector(keepCell) {
    const cells = (KIGALI[dEl.value] && KIGALI[dEl.value][sEl.value]) || [];
    fill(cEl, cells, keepCell ? savedCell : '', 'Select cell');
  }

  dEl.addEventListener('change', () => onDistrict(false));
  sEl.addEventListener('change', () => onSector(false));
  onDistrict(true);
})();

/* ---------- UPI rows ---------- */
(function () {
  const list = document.getElementById('upi-list');
  const hint = document.getElementById('upi-hint');

  function template() {
    const row = document.createElement('div');
    row.className = 'upi-row';
    row.innerHTML =
      '<input class="fi upi-input" name="upis[]" placeholder="1/02/05/03/4745" ' +
      'pattern="[1-5]/[0-9]{2}/[0-9]{2}/[0-9]{2}/[0-9]+(-[0-9]+)?">' +
      '<button type="button" class="btn btn-ghost btn-sm upi-remove">&times;</button>';
    return row;
  }

  document.getElementById('upi-add').addEventListener('click', () => {
    if (list.querySelectorAll('.upi-row').length >= 6) return;
    list.appendChild(template());
  });

  list.addEventListener('click', e => {
    if (e.target.classList.contains('upi-remove')) {
      if (list.querySelectorAll('.upi-row').length > 1) e.target.closest('.upi-row').remove();
    }
  });

  // Insert the slashes as the inspector types digits.
  list.addEventListener('input', e => {
    if (!e.target.classList.contains('upi-input')) return;
    const el = e.target;
    if (el.value.includes('-')) return;

    const digits = el.value.replace(/[^\d]/g, '');
    const groups = [1, 2, 2, 2];
    let out = '', i = 0;

    for (const len of groups) {
      if (i >= digits.length) break;
      out += (out ? '/' : '') + digits.substr(i, len);
      i += len;
    }
    if (i < digits.length) out += '/' + digits.substr(i);
    if (out !== el.value) el.value = out;

    const nonKigali = Array.from(list.querySelectorAll('.upi-input'))
      .some(x => x.value.length > 1 && !x.value.startsWith('1/'));
    hint.textContent = nonKigali
      ? 'This parcel is outside the City of Kigali — check the first digit.'
      : 'Format: province / district / sector / cell / parcel. Kigali parcels begin with 1.';
    hint.classList.toggle('upi-warn', nonKigali);
  });
})();

/* ---------- Photos ---------- */
(function () {
  const MAX = 3;
  const preview = document.getElementById('photo-preview');
  let chosen = [];

  document.querySelectorAll('.photo-input').forEach(input => {
    input.addEventListener('change', () => {
      Array.from(input.files).forEach(f => {
        if (chosen.length >= MAX) return;
        chosen.push(f);
      });
      render();
    });
  });

  function render() {
    preview.innerHTML = '';
    chosen.forEach((f, i) => {
      const d = document.createElement('div');
      d.className = 'ph-thumb';
      const img = document.createElement('img');
      img.src = URL.createObjectURL(f);
      const cap = document.createElement('div');
      cap.className = 'ph-name';
      cap.textContent = f.name;
      const rm = document.createElement('div');
      rm.className = 'ph-del';
      rm.textContent = 'Remove';
      rm.onclick = () => { chosen.splice(i, 1); render(); sync(); };
      d.append(img, cap, rm);
      preview.appendChild(d);
    });
    sync();
  }

  function sync() {
    const dt = new DataTransfer();
    chosen.forEach(f => dt.items.add(f));
    const first = document.querySelector('.photo-input');
    first.files = dt.files;
    document.querySelectorAll('.photo-input').forEach((el, i) => { if (i > 0) el.value = ''; });
  }
})();

/* ---------- Progress and scoring ---------- */
(function () {
  const form = document.getElementById('inspection-form');
  const items = Array.from(form.querySelectorAll('.chk-item'));

  function refresh() {
    let yes = 0, no = 0, na = 0, earned = 0, possible = 0;

    items.forEach(item => {
      const checked = item.querySelector('input[type=radio]:checked');
      const weight = parseFloat(item.dataset.weight) || 0;
      item.querySelectorAll('.sbtn').forEach(b => b.classList.toggle('on', b.querySelector('input').checked));
      if (!checked) return;
      if (checked.value === 'yes') { yes++; earned += weight; possible += weight; }
      else if (checked.value === 'no') { no++; possible += weight; }
      else { na++; }
    });

    const done = yes + no + na;
    document.getElementById('pb-done').textContent = done;
    document.getElementById('pb-fill').style.width = items.length ? (100 * done / items.length) + '%' : '0';
    document.getElementById('t-yes').textContent = yes;
    document.getElementById('t-no').textContent = no;
    document.getElementById('t-na').textContent = na;
    document.getElementById('t-score').textContent = possible > 0 ? Math.round(100 * earned / possible) + '%' : '\u2014';

    form.querySelectorAll('.chk-section').forEach(sec => {
      const n = sec.querySelectorAll('.chk-item input[type=radio]:checked').length;
      const el = sec.querySelector('.sec-done');
      if (el) el.textContent = n;
    });
  }

  form.addEventListener('change', e => { if (e.target.type === 'radio') refresh(); });

  let dirty = false;
  form.addEventListener('input', () => { dirty = true; });
  form.addEventListener('submit', () => { dirty = false; });
  window.addEventListener('beforeunload', e => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });

  refresh();
})();
</script>


{{-- mandatory-checklist --}}


<div class="gap-banner" id="gap-banner">
  <span id="gap-text"></span>
  <button type="button" id="gap-jump">Go to first</button>
</div>

<script>
(function () {
  var form   = document.getElementById('inspection-form');
  var banner = document.getElementById('gap-banner');
  var text   = document.getElementById('gap-text');

  function unanswered() {
    return Array.from(form.querySelectorAll('.chk-item'))
      .filter(function (i) { return !i.querySelector('input[type=radio]:checked'); });
  }

  function mark() {
    var gaps = unanswered();

    form.querySelectorAll('.chk-item').forEach(function (i) { i.classList.remove('unanswered'); });
    gaps.forEach(function (i) { i.classList.add('unanswered'); });

    form.querySelectorAll('.chk-section').forEach(function (sec) {
      var n = Array.from(sec.querySelectorAll('.chk-item'))
        .filter(function (i) { return !i.querySelector('input[type=radio]:checked'); }).length;
      var head = sec.querySelector('.sec-head');
      if (head) head.classList.toggle('has-gap', n > 0);
    });

    return gaps;
  }

  document.getElementById('gap-jump').addEventListener('click', function () {
    var first = form.querySelector('.chk-item.unanswered');
    if (first) {
      first.scrollIntoView({ behavior: 'smooth', block: 'center' });
      banner.style.display = 'none';
    }
  });

  form.addEventListener('change', function (e) {
    if (e.target.type === 'radio' && banner.style.display === 'flex') {
      if (mark().length === 0) banner.style.display = 'none';
    }
  });

  form.addEventListener('submit', function (e) {
    var completing = document.activeElement && document.activeElement.value === 'complete';
    if (!completing) return;

    var gaps = mark();
    if (gaps.length === 0) return;

    e.preventDefault();
    text.textContent = gaps.length + ' checklist ' +
      (gaps.length === 1 ? 'item still needs' : 'items still need') +
      ' an answer. Save as draft if you need to finish later.';
    banner.style.display = 'flex';
    gaps[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
})();
</script>


