{{-- Libraries load at the end of the body so the page renders first.
     Chart.js must not be deferred: the chart code in each view is inline
     and would otherwise run before the library exists. --}}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

{{-- The administrative structure, used by every cascading location selector --}}
<script>window.KIGALI = @json(config('kigali'));</script>

<script>
/* ---------- Navigation ---------- */
(function(){
  var t=document.getElementById('menu-toggle'), b=document.getElementById('backdrop');
  function set(o){document.body.classList.toggle('nav-open',o);t.setAttribute('aria-expanded',o);}
  t.addEventListener('click',function(){set(!document.body.classList.contains('nav-open'));});
  b.addEventListener('click',function(){set(false);});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')set(false);});
})();

/* ---------- Chart defaults ---------- */
window.CoK = { primary:'#34A8DB', primaryDark:'#2980B9', secondary:'#FFEB3B',
               success:'#4CAF50', warning:'#F39C12', danger:'#E74C3C',
               tertiary:'#CDB896', grid:'#E0E0E0',
               blue:'#34A8DB', green:'#4CAF50', gold:'#F39C12', red:'#E74C3C', teal:'#2980B9' };

if (window.Chart) {
  Chart.defaults.font.family = "'Montserrat', sans-serif";
  Chart.defaults.font.size = 11.5;
  Chart.defaults.color = '#555555';
  Chart.defaults.plugins.legend.labels.boxWidth = 10;
  Chart.defaults.plugins.legend.labels.boxHeight = 10;
  Chart.defaults.plugins.legend.labels.usePointStyle = true;
  Chart.defaults.plugins.legend.labels.padding = 15;
  Chart.defaults.plugins.tooltip.backgroundColor = '#333333';
  Chart.defaults.plugins.tooltip.padding = 11;
  Chart.defaults.plugins.tooltip.cornerRadius = 0;
  Chart.defaults.plugins.tooltip.titleFont = {family:"'Montserrat', sans-serif", weight:'700'};
}

/* ==========================================================
   Filter bar — shared by every screen that filters.
   Applies on change; a custom date range waits for its own
   Apply, since there is nothing to filter by until a date is set.
   ========================================================== */
(function () {
  var panel = document.getElementById('fpanel');
  if (!panel) return;

  function apply() {
    panel.classList.add('fp-busy');
    panel.submit();
  }

  /* ---- Cascading district, sector, cell ---- */
  var dEl = document.getElementById('district');
  var sEl = document.getElementById('sector');
  var cEl = document.getElementById('cell');

  if (dEl && sEl && cEl && window.KIGALI) {
    var savedSector = panel.dataset.sector || '';
    var savedCell   = panel.dataset.cell || '';

    var key = function () {
      var opt = dEl.options[dEl.selectedIndex];
      return dEl.value || (opt ? opt.textContent.trim() : '');
    };

    var fill = function (select, values, selected, placeholder) {
      select.innerHTML = '<option value="">' + placeholder + '</option>';
      values.forEach(function (v) {
        var o = document.createElement('option');
        o.value = v; o.textContent = v;
        if (v === selected) o.selected = true;
        select.appendChild(o);
      });
      select.disabled = values.length === 0;
    };

    var onSector = function (keep) {
      var cells = (KIGALI[key()] && KIGALI[key()][sEl.value]) || [];
      fill(cEl, cells, keep ? savedCell : '', 'All cells');
    };

    var onDistrict = function (keep) {
      var sectors = KIGALI[key()] ? Object.keys(KIGALI[key()]) : [];
      fill(sEl, sectors, keep ? savedSector : '', 'All sectors');
      onSector(keep);
    };

    onDistrict(true);

    dEl.addEventListener('change', function () { onDistrict(false); apply(); });
    sEl.addEventListener('change', function () { onSector(false); apply(); });
    cEl.addEventListener('change', apply);
  }

  /* ---- Period ---- */
  var btn    = document.getElementById('date-btn');
  var pop    = document.getElementById('date-pop');
  var period = document.getElementById('period');
  var fromEl = document.getElementById('from');
  var toEl   = document.getElementById('to');

  if (btn && pop) {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      btn.setAttribute('aria-expanded', pop.classList.toggle('on'));
    });

    pop.addEventListener('click', function (e) { e.stopPropagation(); });
    document.addEventListener('click', function () { pop.classList.remove('on'); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') pop.classList.remove('on');
    });

    /* Choosing a preset clears any custom dates, so the heading and the
       figures cannot disagree about which window is in force. */
    pop.querySelectorAll('.dp-item').forEach(function (item) {
      item.addEventListener('click', function () {
        period.value = item.dataset.period;
        if (fromEl) fromEl.value = '';
        if (toEl) toEl.value = '';
        apply();
      });
    });

    var applyBtn = document.getElementById('date-apply');
    if (applyBtn) {
      applyBtn.addEventListener('click', function () {
        if (!fromEl.value && !toEl.value) { pop.classList.remove('on'); return; }
        period.value = 'custom';
        apply();
      });
    }
  }
})();
</script>

@yield('scripts')
</body>
</html>