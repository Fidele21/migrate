{{--
  The enforcement letter, in the City of Kigali format.

  Structure follows the approved template exactly:
    page 1  letterhead, reference, addressee, subject, citation
            paragraphs, requirement, signature, distribution list
    page 2  the annexe listing what must be put right

  Word reads this as HTML. Page geometry comes from the @page rule, and
  the letterhead spans the margin by way of a negative margin matching it.
--}}

@php
  use App\Support\ComplianceBand;

  $inspection = $letter->inspection;
  $entity     = $inspection?->entity;
  $cfg        = config('letters');

  /* The registry reference. The Secretary types the serial from the
     register book kept outside this platform, so until it is recorded
     the line shows the dotted rule of the printed form. */
  $serial   = $letter->reference_number ?: str_repeat('.', 22);
  $registry = data_get($cfg, 'reference.registry_code', '07.01.14');
  $refYear  = ($letter->issued_at ?? $letter->created_at ?? now())->format('y');

  $letterDate = $letter->issued_at
      ? $letter->issued_at->format('d/m/Y')
      : str_repeat('.', 16);

  /* What the premises failed. A prohibition item — a kitchen at a petrol
     station — is failed by answering yes, so the test is inverted. */
  $failures = collect();

  if ($inspection && $inspection->template) {
      $answers = $inspection->answers->keyBy('item_id');

      foreach ($inspection->template->sections as $section) {
          foreach ($section->items as $item) {
              $a = $answers->get($item->id);
              if (! $a || ! in_array($a->status, ['yes', 'no'], true)) continue;

              $complied = $item->is_prohibition ? $a->status === 'no' : $a->status === 'yes';

              if (! $complied) {
                  $failures->push((object) [
                      'section' => $section->title,
                      'label'   => rtrim($item->label, '. '),
                      'comment' => $a->comment,
                      'banned'  => (bool) $item->is_prohibition,
                  ]);
              }
          }
      }
  }

  $deadline = $letter->deadline_days ?: data_get($cfg, 'default_deadline_days', 30);
@endphp

<!DOCTYPE html>
<html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word" lang="rw">
