<!--[if gte mso 9]><xml>
  <w:WordDocument><w:View>Print</w:View><w:Zoom>100</w:Zoom></w:WordDocument>
</xml><![endif]-->

<style>
  /* Letter size, one inch left and right, nothing top or bottom —
     the letterhead and the footer occupy those. */
  @page{
    size:8.5in 11in;
    margin:0in 1in 0in 1in;
  }

  body{
    font-family:'Montserrat',Calibri,Arial,sans-serif;
    font-size:11pt;
    line-height:1.5;
    color:#000;
    margin:0;
  }

  p,div,td,li,span{
    font-family:'Montserrat',Calibri,Arial,sans-serif;
    font-size:11pt;
  }

  /* The letterhead reaches the edge of the sheet; the text does not. */
  .letterhead{margin:0 -1in 14pt -1in}
  .letterhead img{display:block;width:100%;height:auto}

  .ref-row{width:100%;border-collapse:collapse;margin-bottom:22pt}
  .ref-row td{font-size:11pt;vertical-align:top;padding:0}
  .ref-left{text-align:left}
  .ref-right{text-align:right}

  .addressee{margin-bottom:2pt;font-weight:bold}
  .addressee-tel{margin-bottom:2pt;font-weight:bold}
  .addressee-city{font-weight:bold;text-decoration:underline;margin-bottom:18pt}

  .subject{margin-bottom:16pt}
  .subject b{text-decoration:underline}

  .salutation{margin-bottom:12pt}

  .clause{text-align:justify;margin-bottom:12pt}

  .closing{margin-top:18pt;margin-bottom:26pt}

  .sig{margin-bottom:4pt}
  .sig img{height:52pt;display:block;margin-bottom:2pt}
  .sig b{display:block;font-weight:bold}

  .cc-title{font-weight:bold;margin-top:20pt;margin-bottom:5pt}
  .cc{margin:0 0 2pt 0;font-size:10.5pt}

  .end-city{font-weight:bold;margin-top:14pt;text-align:center}

  .foot{margin-top:26pt;padding-top:7pt;border-top:0.5pt solid #999;
        font-size:8.5pt;color:#333;text-align:center}

  /* ---- The annexe ---- */
  .annex{page-break-before:always}
  .annex-title{font-weight:bold;text-decoration:underline;text-align:center;
               font-size:10pt;margin-bottom:14pt}
  table.items{width:100%;border-collapse:collapse;font-size:10pt}
  table.items th{border:0.5pt solid #999;background:#EFEFEF;padding:5pt 6pt;
                 text-align:left;font-weight:bold;font-size:9.5pt}
  table.items td{border:0.5pt solid #999;padding:5pt 6pt;vertical-align:top;font-size:10pt}
  td.no{width:24pt;text-align:center}
  .banned{color:#B71C1C;font-weight:bold}
  .note{font-size:9pt;color:#444;font-style:italic}
</style>
</head>
<body>

